<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.astudyonmyself.maintain</string>
  <key>WorkingDirectory</key><string>@APP@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>scripts/cli.ts</string>
    <string>maintain</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <!-- Hourly; a run missed while the Mac slept happens on wake. -->
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>@LOGS@/maintain.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/maintain.log</string>
</dict>
</plist>
