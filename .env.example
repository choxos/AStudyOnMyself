# Copy to .env (never committed) and fill in what you use. Everything is optional.
# After changing it, run scripts/install-launchd.sh again so the running app sees it.

# Where the database, logs, backups and posterior draws live (outside the repo).
# ASOM_DATA_DIR=~/.astudyonmyself

# The HTTPS name your phone uses, from `tailscale serve` (see README).
# ASOM_HOST=your-mac.your-tailnet.ts.net

# Defaults to the machine's zone and port 8000.
# TIME_ZONE=America/Vancouver
# PORT=8000

# Weather and outdoor PM2.5 from Open-Meteo (no API key). Use rounded coordinates.
# WEATHER_LATITUDE=45.00
# WEATHER_LONGITUDE=-75.00

# Encrypted daily backups: the fingerprint of a GPG key you control.
# gpg --quick-generate-key "AStudyOnMyself backup"   then   gpg --list-keys
# BACKUP_GPG_RECIPIENT=ABCDEF0123456789ABCDEF0123456789ABCDEF01
# ASOM_BACKUP_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/AStudyOnMyself backups
# BACKUP_KEEP=30

# Public results page: a local clone of your GitHub Pages repository and the
# folder inside it for this page (required; the repository root is refused).
# PUBLISH_DIR=~/.astudyonmyself/publish/choxos.github.io
# PUBLISH_SUBDIR=astudyonmyself

# Ring metrics from the Ultrahuman Partner API (apply at partner.ultrahuman.com).
# ULTRAHUMAN_TOKEN=

# Indoor air: run `node scripts/cli.ts alexa-login` once. Use amazon.ca for a
# Canadian Alexa account.
# ALEXA_DOMAIN=amazon.com

# Path to Rscript if it is not on the PATH.
# RSCRIPT=/usr/local/bin/Rscript
